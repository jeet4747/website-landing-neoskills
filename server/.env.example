# Optional recipient for automated WhatsApp callback notifications.
#
# Option 1 (quickest): CallMeBot. Follow its current setup instructions, allow
# CallMeBot to send you messages, then paste the API key supplied in its reply.
WHATSAPP_COUNSELLOR_NUMBER=
CALLMEBOT_APIKEY=

# Option 2: use an automation service such as Make, Zapier, or your WhatsApp
# Business provider. Set its HTTPS endpoint here; NeoSkills sends the name,
# phone, and formatted text as JSON.
WHATSAPP_WEBHOOK_URL=

# Callback leads are sent here when an email provider is configured.
LEAD_EMAIL=contact@neoskills.co.in 
