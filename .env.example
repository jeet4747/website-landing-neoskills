VITE_BACKEND_URL=http://localhost:4000
VITE_ADMIN_PASSWORD=change-this-password
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v2-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v2-secret-key

# ─── Email delivery (server-side) ───
# Render's FREE tier blocks outbound SMTP (ports 25/465/587), so email MUST go
# through an HTTPS API. Configure ONE of these (first match wins: Resend > SendGrid > Brevo).
# Resend (recommended, easiest): https://resend.com/api-keys
RESEND_API_KEY=
# Sender address used for outgoing mail. On Resend you can start with the
# shared sender "onboarding@resend.dev", or verify your domain and use e.g. leads@neoskills.co.in
MAIL_FROM=
# SendGrid: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Inbox that receives lead/callback notifications
LEAD_EMAIL=contact@neoskills.co.in

# ─── SMTP fallback (works locally and on PAID Render instances only) ───
ZOHO_EMAIL=
ZOHO_PASSWORD=
# Optional custom SMTP host (e.g. smtp.zoho.in). Leave blank to use Gmail.
SMTP_HOST=
SMTP_PORT=
